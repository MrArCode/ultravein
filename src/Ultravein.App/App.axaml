<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ultravein.App.App"
             xmlns:local="using:Ultravein.App"
             Name="Ultravein"
             RequestedThemeVariant="Default">
    <!-- "Default" podąża za motywem systemu. Inne opcje: "Light", "Dark". -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
